# =========================================================
# HELPERS
# =========================================================

def clean_text(value, limit=4000):
    return (
        str(value or "")
        .replace("\x00", "")
        .strip()[:limit]
    )


def now_text():
    return datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )


def require_windows():
    if not IS_WINDOWS:
        raise RuntimeError(
            "Windows is required for desktop control"
        )


def clamp(value, minimum, maximum):
    return max(
        minimum,
        min(maximum, value)
    )


