# =========================================================
# SEND INPUT
# =========================================================

def send_input(item):
    require_windows()

    sent = USER32.SendInput(
        1,
        ctypes.byref(item),
        ctypes.sizeof(INPUT)
    )

    if sent != 1:
        raise RuntimeError(
            "Windows SendInput failed"
        )


# =========================================================
# COORDINATES
# =========================================================

def resolve_point(
    x,
    y,
    coordinate_mode="screenshot"
):
    geometry = get_screen_geometry()

    x = float(x)
    y = float(y)

    mode = clean_text(
        coordinate_mode,
        50
    ).lower()

    if mode in (
        "normalized",
        "norm",
        "1000"
    ):
        relative_x = (
            x / 1000.0
            *
            geometry["width"]
        )

        relative_y = (
            y / 1000.0
            *
            geometry["height"]
        )

    elif mode in (
        "absolute",
        "desktop",
        "windows"
    ):
        return {
            "x": int(round(x)),
            "y": int(round(y)),
            "screen": geometry
        }

    else:
        relative_x = x
        relative_y = y

    relative_x = clamp(
        int(round(relative_x)),
        0,
        max(
            0,
            geometry["width"] - 1
        )
    )

    relative_y = clamp(
        int(round(relative_y)),
        0,
        max(
            0,
            geometry["height"] - 1
        )
    )

    return {
        "x":
            geometry["left"]
            +
            relative_x,

        "y":
            geometry["top"]
            +
            relative_y,

        "relativeX":
            relative_x,

        "relativeY":
            relative_y,

        "screen":
            geometry
    }


# =========================================================
# CURSOR
# =========================================================

def get_cursor():
    require_windows()

    point = POINT()

    success = USER32.GetCursorPos(
        ctypes.byref(point)
    )

    if not success:
        raise RuntimeError(
            "Could not read cursor"
        )

    return {
        "x": int(point.x),
        "y": int(point.y)
    }


# =========================================================
# MOUSE MOVE
# =========================================================

def mouse_move(
    x,
    y,
    coordinate_mode="screenshot",
    pause_after=0
):
    require_windows()

    point = resolve_point(
        x,
        y,
        coordinate_mode
    )

    success = USER32.SetCursorPos(
        point["x"],
        point["y"]
    )

    if not success:
        raise RuntimeError(
            "Mouse move failed"
        )

    try:
        pause_after = float(
            pause_after or 0
        )
    except Exception:
        pause_after = 0

    pause_after = clamp(
        pause_after,
        0,
        0.2
    )

    if pause_after:
        time.sleep(
            pause_after
        )

    return {
        "moved": True,
        **point
    }


# =========================================================
# RAW MOUSE CLICK
# =========================================================

def raw_click(button="left"):
    require_windows()

    button = clean_text(
        button,
        20
    ).lower()

    if button == "right":
        down_flag = MOUSEEVENTF_RIGHTDOWN
        up_flag = MOUSEEVENTF_RIGHTUP

    else:
        down_flag = MOUSEEVENTF_LEFTDOWN
        up_flag = MOUSEEVENTF_LEFTUP

    down = INPUT(
        type=INPUT_MOUSE
    )

    down.union.mi = MOUSEINPUT(
        0,
        0,
        0,
        down_flag,
        0,
        0
    )

    up = INPUT(
        type=INPUT_MOUSE
    )

    up.union.mi = MOUSEINPUT(
        0,
        0,
        0,
        up_flag,
        0,
        0
    )

    send_input(down)

    time.sleep(0.008)

    send_input(up)


# =========================================================
# CLICK
# =========================================================

def mouse_click(
    x=None,
    y=None,
    coordinate_mode="screenshot",
    button="left",
    clicks=1,
    interval=0.07,
    pause_after=0.02
):

    if (
        x is not None
        and
        y is not None
    ):
        point = mouse_move(
            x,
            y,
            coordinate_mode,
            pause_after=0
        )

    else:
        point = get_cursor()

    try:
        clicks = int(
            clicks or 1
        )
    except Exception:
        clicks = 1

    clicks = clamp(
        clicks,
        1,
        3
    )

    try:
        interval = float(
            interval or 0.07
        )
    except Exception:
        interval = 0.07

    interval = clamp(
        interval,
        0.02,
        1.0
    )

    for index in range(clicks):
        raw_click(button)

        if index < clicks - 1:
            time.sleep(interval)

    try:
        pause_after = float(
            pause_after or 0
        )
    except Exception:
        pause_after = 0

    pause_after = clamp(
        pause_after,
        0,
        0.15
    )

    if pause_after:
        time.sleep(pause_after)

    return {
        "clicked": True,
        "button": button,
        "clicks": clicks,
        "x": point["x"],
        "y": point["y"]
    }


def mouse_double_click(
    x=None,
