# =========================================================
# SCROLL
# =========================================================

def mouse_scroll(
    amount,
    x=None,
    y=None,
    coordinate_mode="screenshot"
):
    require_windows()

    try:
        amount = int(amount)
    except Exception:
        raise RuntimeError(
            "Invalid scroll amount"
        )

    amount = clamp(
        amount,
        -MAX_SCROLL_AMOUNT,
        MAX_SCROLL_AMOUNT
    )

    if amount == 0:
        return {
            "scrolled": False,
            "amount": 0
        }

    if (
        x is not None
        and
        y is not None
    ):
        mouse_move(
            x,
            y,
            coordinate_mode,
            pause_after=0
        )

    item = INPUT(
        type=INPUT_MOUSE
    )

    mouse_data = ctypes.c_ulong(
        amount * WHEEL_DELTA
    ).value

    item.union.mi = MOUSEINPUT(
        0,
        0,
        mouse_data,
        MOUSEEVENTF_WHEEL,
        0,
        0
    )

    send_input(item)

    time.sleep(0.04)

    return {
        "scrolled": True,
        "amount": amount
    }


# =========================================================
# KEYBOARD HELPERS
# =========================================================

def virtual_key(key):
    key = clean_text(
        key,
        50
    ).lower()

    value = KEY_MAP.get(key)

    if value is None:
        raise RuntimeError(
            "Unsupported key: "
            +
            key
        )

    return value


def send_virtual_key(
    key,
    key_up=False
):
    flags = (
        KEYEVENTF_KEYUP
        if key_up
        else 0
    )

    item = INPUT(
        type=INPUT_KEYBOARD
    )

    item.union.ki = KEYBDINPUT(
        key,
        0,
        flags,
        0,
        0
    )

    send_input(item)


# =========================================================
# PRESS KEY
# =========================================================

def press_key(
    key,
    presses=1,
    interval=0.04
):
    require_windows()

    vk = virtual_key(key)

    try:
        presses = int(
            presses or 1
        )
    except Exception:
        presses = 1

    presses = clamp(
        presses,
        1,
        20
    )

    try:
        interval = float(
            interval or 0.04
        )
    except Exception:
        interval = 0.04

    interval = clamp(
        interval,
        0.01,
        1.0
    )

    for index in range(
        presses
    ):
        send_virtual_key(
            vk,
            False
        )

        time.sleep(0.006)

        send_virtual_key(
            vk,
            True
        )

        if index < presses - 1:
            time.sleep(interval)

    return {
        "pressed": clean_text(
            key,
            50
        ),

        "presses": presses
    }


# =========================================================
# HOTKEY
# =========================================================

def hotkey(keys):
    require_windows()

    if isinstance(
        keys,
        str
    ):
        keys = [
            item.strip()
            for item in keys.split("+")
            if item.strip()
        ]

    if not isinstance(
        keys,
        list
    ):
        raise RuntimeError(
            "Hotkey keys invalid"
        )

    keys = [
        clean_text(
            item,
            50
        ).lower()
        for item in keys[:5]
        if clean_text(
            item,
            50
        )
    ]

    if not keys:
        raise RuntimeError(
            "Hotkey is empty"
        )

    values = [
        virtual_key(key)
        for key in keys
    ]

    for value in values:
        send_virtual_key(
            value,
            False
        )

        time.sleep(0.005)

    for value in reversed(
        values
    ):
        send_virtual_key(
            value,
            True
        )

        time.sleep(0.005)

    return {
        "hotkey": keys
    }


# =========================================================
# UNICODE TYPING
# =========================================================

def send_unicode_character(
    character
):
    require_windows()

    encoded = character.encode(
        "utf-16-le"
    )

    for index in range(
        0,
        len(encoded),
        2
    ):
        code_unit = int.from_bytes(
            encoded[
                index:
                index + 2
            ],
            "little"
        )

        down = INPUT(
            type=INPUT_KEYBOARD
        )

        down.union.ki = KEYBDINPUT(
            0,
            code_unit,
            KEYEVENTF_UNICODE,
            0,
            0
        )

        up = INPUT(
            type=INPUT_KEYBOARD
        )

        up.union.ki = KEYBDINPUT(
            0,
            code_unit,
            KEYEVENTF_UNICODE
            |
            KEYEVENTF_KEYUP,
            0,
            0
        )

        send_input(down)
        send_input(up)


def type_text(
    text,
    interval=0,
    press_enter=False
):
    require_windows()

    text = clean_text(
        text,
        MAX_TYPE_TEXT_LENGTH
    )

    if not text:
        raise RuntimeError(
            "Text is empty"
        )

    try:
        interval = float(
            interval or 0
        )
    except Exception:
        interval = 0

    interval = clamp(
        interval,
        0,
        0.1
    )

    for character in text:
        send_unicode_character(
            character
        )

        if interval:
            time.sleep(interval)

    if press_enter:
        press_key("enter")

    return {
        "typed": True,
        "length": len(text),
        "pressedEnter":
            bool(press_enter)
    }


# =========================================================
# EXECUTE COMMAND
# =========================================================

def execute_command(command):
    command_id = clean_text(
        command.get("id"),
        200
    )

    action = clean_text(
        command.get("action"),
        100
    )

    args = command.get("args")

    if not isinstance(
        args,
        dict
    ):
        args = {}

    print(
        f"📥 {action} | {command_id}"
    )

    if action == "status":
        return computer_status()

    if action == "screenshot":
        return take_screenshot()

    if action == "open_app":
        return open_app(
            args.get("app")
            or
            args.get("name")
            or
            ""
        )

    if action == "open_url":
        return open_url(
            args.get("url")
            or
            ""
        )

    if action == "find_file":
        return find_file(
            args.get("query")
            or
            "",
            args.get("root")
        )

    if action == "get_cursor":
        return get_cursor()

    if action == "mouse_move":
        return mouse_move(
            args.get("x"),
            args.get("y"),
            args.get(
                "coordinateMode"
            )
            or
            args.get(
                "coordinate_mode"
            )
            or
            "screenshot",
            args.get(
                "pauseAfter"
            )
            or
            0
        )

    if action == "mouse_click":
        return mouse_click(
            x=args.get("x"),
            y=args.get("y"),

            coordinate_mode=(
                args.get(
                    "coordinateMode"
                )
                or
                args.get(
                    "coordinate_mode"
                )
                or
                "screenshot"
            ),

            button=(
                args.get("button")
                or
                "left"
            ),

            clicks=(
                args.get("clicks")
                or
                1
            ),

            interval=(
                args.get("interval")
                or
                0.07
            ),

            pause_after=(
                args.get("pauseAfter")
                if
                args.get("pauseAfter")
                is not None
                else
                0.02
            )
        )

    if action == "mouse_double_click":
        return mouse_double_click(
            x=args.get("x"),
            y=args.get("y"),

            coordinate_mode=(
                args.get(
                    "coordinateMode"
                )
                or
                args.get(
                    "coordinate_mode"
                )
                or
                "screenshot"
            )
        )

    if action == "mouse_right_click":
        return mouse_right_click(
            x=args.get("x"),
            y=args.get("y"),

            coordinate_mode=(
                args.get(
                    "coordinateMode"
                )
                or
                args.get(
                    "coordinate_mode"
                )
                or
                "screenshot"
            )
        )

    if action == "mouse_scroll":
        return mouse_scroll(
            amount=(
                args.get("amount")
                or
                args.get("steps")
                or
                0
            ),

            x=args.get("x"),
            y=args.get("y"),

            coordinate_mode=(
                args.get(
                    "coordinateMode"
                )
                or
                args.get(
                    "coordinate_mode"
                )
                or
                "screenshot"
            )
        )

    if action == "type_text":
        return type_text(
            text=(
                args.get("text")
                or
                ""
            ),

            interval=(
                args.get("interval")
                if
                args.get("interval")
                is not None
                else
                0
            ),

            press_enter=bool(
                args.get(
                    "pressEnter"
                )
                or
                args.get(
                    "press_enter"
                )
            )
        )

    if action == "press_key":
        return press_key(
            key=(
                args.get("key")
                or
                ""
            ),

            presses=(
                args.get("presses")
                or
                1
            ),

            interval=(
                args.get("interval")
                or
                0.04
            )
        )

    if action == "hotkey":
        return hotkey(
            args.get("keys")
            or
            []
        )

    raise RuntimeError(
        "Unsupported action: "
        +
        action
    )


# =========================================================
# SEND RESULT
# =========================================================

def send_result(
    command_id,
    status,
    result
):
    return api_request(
        "POST",
        "/api/agent/result",
        {
            "deviceId":
                KEMO_DESKTOP_DEVICE_ID,

            "commandId":
                command_id,

            "status":
                status,

            "result":
                result
        }
    )


# =========================================================
# NEXT COMMAND
# =========================================================

def get_next_command():
    device_id = urllib.parse.quote(
        KEMO_DESKTOP_DEVICE_ID,
        safe=""
    )

    response = api_request(
        "GET",
        (
            "/api/agent/next"
            +
            "?deviceId="
            +
            device_id
        )
    )

    return response.get(
        "command"
    )


# =========================================================
# MAIN LOOP
# =========================================================

def run_agent():
    print_header()

    if not validate_config():
        input(
            "Press Enter to close..."
        )
        return

    if not IS_WINDOWS:
        print(
            "❌ Windows is required."
        )

        input(
            "Press Enter to close..."
        )
        return

    print(
        "🔄 Connecting to Kemo Desktop Bridge..."
    )

    try:
        heartbeat = send_heartbeat()

        if not heartbeat.get("ok"):
            raise RuntimeError(
                "Heartbeat rejected"
            )

        print(
            "✅ Connected"
        )

        print(
            "✅ Computer ONLINE"
        )

        print(
            "⚡ FAST mouse control ready"
        )

        print(
            "🛡️ Strict command-only execution"
        )

        print("")

    except Exception as error:
        print(
            f"❌ Connection failed: {error}"
        )

        input(
            "Press Enter to close..."
        )
        return

    last_heartbeat = (
        time.monotonic()
    )

    while True:
        try:
            now = time.monotonic()

            if (
                now
                -
                last_heartbeat
                >=
                HEARTBEAT_SECONDS
            ):
                send_heartbeat()
                last_heartbeat = now

            command = get_next_command()

            if command:
                command_id = clean_text(
                    command.get("id"),
                    200
                )

                action = clean_text(
                    command.get("action"),
                    100
                )

                started = time.perf_counter()

                try:
                    result = execute_command(
                        command
                    )

                    send_result(
                        command_id,
                        "completed",
                        result
                    )

                    elapsed = (
                        time.perf_counter()
                        -
                        started
                    )

                    print(
                        f"✅ {action} | {elapsed:.3f}s"
                    )

                except Exception as error:
                    try:
                        send_result(
                            command_id,
                            "failed",
                            {
                                "error":
                                    str(error)
                            }
                        )
                    except Exception:
                        pass

                    print(
                        f"❌ Command failed: {error}"
                    )

            time.sleep(
                POLL_SECONDS
            )

        except KeyboardInterrupt:
            print("")
            print(
                "👋 Agent stopped"
            )
            break

        except Exception as error:
            print(
                f"⚠️ Network: {error}"
            )

            time.sleep(0.5)


# =========================================================
# START
# =========================================================

if __name__ == "__main__":
    run_agent()
