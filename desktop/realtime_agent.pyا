# =========================================================
# SCREEN
# =========================================================

def get_selected_monitor(sct):
    monitors = sct.monitors

    index = KEMO_SCREEN_INDEX

    if index < 1 or index >= len(monitors):
        index = 1

    return monitors[index]


def get_screen_geometry():
    with mss.MSS() as sct:
        monitor = get_selected_monitor(sct)

        return {
            "left": int(monitor["left"]),
            "top": int(monitor["top"]),
            "width": int(monitor["width"]),
            "height": int(monitor["height"])
        }


# =========================================================
# SCREENSHOT
# =========================================================

def take_screenshot():
    SCREENSHOT_FOLDER.mkdir(
        parents=True,
        exist_ok=True
    )

    timestamp = datetime.now().strftime(
        "%Y-%m-%d_%H-%M-%S_%f"
    )

    output_path = (
        SCREENSHOT_FOLDER
        /
        f"kemo_screen_{timestamp}.png"
    )

    with mss.MSS() as sct:
        monitor = get_selected_monitor(sct)

        shot = sct.grab(monitor)

        mss_tools.to_png(
            shot.rgb,
            shot.size,
            output=str(output_path)
        )

        geometry = {
            "left": int(monitor["left"]),
            "top": int(monitor["top"]),
            "width": int(monitor["width"]),
            "height": int(monitor["height"])
        }

    file_size = output_path.stat().st_size

    if file_size > MAX_SCREENSHOT_BASE64_BYTES:
        raise RuntimeError(
            "Screenshot is too large"
        )

    with open(output_path, "rb") as file:
        encoded = base64.b64encode(
            file.read()
        ).decode("ascii")

    return {
        "path": str(output_path),
        "filename": output_path.name,
        "capturedAt": now_text(),
        "screen": geometry,
        "imageWidth": geometry["width"],
        "imageHeight": geometry["height"],
        "sizeBytes": file_size,
        "imageBase64": encoded,
        "mimeType": "image/png"
    }


# =========================================================
# OPEN APP
# =========================================================

def open_app(app_name):
    app_name = clean_text(
        app_name,
        100
    ).lower()

    command = APP_COMMANDS.get(
        app_name
    )

    if not command:
        raise RuntimeError(
            "App is not approved: "
            +
            app_name
        )

    subprocess.Popen(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    )

    return {
        "opened": app_name,
        "time": now_text()
    }


# =========================================================
# OPEN URL
# =========================================================

def open_url(url):
    url = clean_text(
        url,
        2000
    )

    if not (
        url.startswith("https://")
        or
        url.startswith("http://")
    ):
        raise RuntimeError(
            "Only http/https URLs are allowed"
        )

    opened = webbrowser.open(
        url,
        new=2
    )

    return {
        "opened": bool(opened),
        "url": url
    }


# =========================================================
# FIND FILE
# =========================================================

def find_file(query, root=None):
    query = clean_text(
        query,
        300
    ).lower()

    if not query:
        raise RuntimeError(
            "File search query is empty"
        )

    home = Path.home().resolve()

    if root:
        requested_root = Path(
            clean_text(
                root,
                1000
            )
        ).expanduser()
    else:
        requested_root = home

    try:
        requested_root = requested_root.resolve()
        requested_root.relative_to(home)

    except Exception:
        requested_root = home

    results = []

    skipped = {
        "AppData",
        ".git",
        "node_modules",
        "__pycache__"
    }

    for current_root, dirs, files in os.walk(
        requested_root
    ):

        dirs[:] = [
            folder
            for folder in dirs
            if folder not in skipped
        ]

        for filename in files:
            if query in filename.lower():

                full_path = (
                    Path(current_root)
                    /
                    filename
                )

                results.append(
                    str(full_path)
                )

                if len(results) >= MAX_FILE_RESULTS:
                    return {
                        "query": query,
                        "count": len(results),
                        "results": results,
                        "limited": True
                    }

    return {
        "query": query,
        "count": len(results),
        "results": results,
        "limited": False
    }


# =========================================================
# WINDOWS INPUT STRUCTURES
# =========================================================

ULONG_PTR = wintypes.WPARAM


class MOUSEINPUT(ctypes.Structure):
    _fields_ = [
        ("dx", wintypes.LONG),
        ("dy", wintypes.LONG),
        ("mouseData", wintypes.DWORD),
        ("dwFlags", wintypes.DWORD),
        ("time", wintypes.DWORD),
        ("dwExtraInfo", ULONG_PTR)
    ]


class KEYBDINPUT(ctypes.Structure):
    _fields_ = [
        ("wVk", wintypes.WORD),
        ("wScan", wintypes.WORD),
        ("dwFlags", wintypes.DWORD),
        ("time", wintypes.DWORD),
        ("dwExtraInfo", ULONG_PTR)
    ]


class HARDWAREINPUT(ctypes.Structure):
    _fields_ = [
        ("uMsg", wintypes.DWORD),
        ("wParamL", wintypes.WORD),
        ("wParamH", wintypes.WORD)
    ]


class INPUT_UNION(ctypes.Union):
    _fields_ = [
        ("mi", MOUSEINPUT),
        ("ki", KEYBDINPUT),
        ("hi", HARDWAREINPUT)
    ]


class INPUT(ctypes.Structure):
    _fields_ = [
        ("type", wintypes.DWORD),
        ("union", INPUT_UNION)
    ]


class POINT(ctypes.Structure):
    _fields_ = [
        ("x", wintypes.LONG),
        ("y", wintypes.LONG)
    ]


