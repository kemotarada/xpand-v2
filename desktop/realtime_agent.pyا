# =========================================================
# HTTP
# =========================================================

def api_request(method, endpoint, payload=None):
    url = KEMO_DESKTOP_URL + endpoint

    data = None

    if payload is not None:
        data = json.dumps(
            payload,
            ensure_ascii=False
        ).encode("utf-8")

    request = urllib.request.Request(
        url,
        data=data,
        method=method
    )

    request.add_header(
        "X-Kemo-Desktop-Key",
        KEMO_DESKTOP_KEY
    )

    request.add_header(
        "Content-Type",
        "application/json"
    )

    request.add_header(
        "User-Agent",
        "KemoDesktopAgent/" + VERSION
    )

    try:
        with urllib.request.urlopen(
            request,
            timeout=HTTP_TIMEOUT
        ) as response:

            raw = response.read().decode(
                "utf-8"
            )

            if not raw:
                return {}

            return json.loads(raw)

    except urllib.error.HTTPError as error:
        raw = error.read().decode(
            "utf-8",
            errors="replace"
        )

        raise RuntimeError(
            f"HTTP {error.code}: {raw}"
        )

    except urllib.error.URLError as error:
        raise RuntimeError(
            f"Network error: {error}"
        )


