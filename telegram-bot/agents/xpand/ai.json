{
  "schema_version": "1.0",
  "agent_id": "xpand",
  "agent_name": "XPAND Agent",

  "provider": {
    "primary": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api": "interactions",
    "verified": false
  },

  "routing_policy": {
    "all_agent_reasoning": "gemini",
    "all_new_capabilities_inherit_provider": true,
    "capabilities_must_use_agent_ai_gateway": true,
    "allow_direct_gemini_reasoning": true,
    "allow_silent_provider_fallback": false,
    "fallback_provider": "gemini"
  },

  "voice_pipeline": {
    "stt": {
      "provider": "gemini",
      "role": "speech_to_text_only"
    },
    "reasoning": {
      "provider": "gemini",
      "model": "gemini-3.5-flash-lite"
    },
    "tts": {
      "provider": "gemini",
      "role": "text_to_speech_only"
    },
    "verified": true
  },

  "future_capability_policy": {
    "web_search": "gemini_reasoning",
    "company_knowledge": "gemini_reasoning",
    "documents_rag": "gemini_reasoning",
    "crm": "gemini_reasoning",
    "lead_capture": "gemini_reasoning",
    "appointments": "gemini_reasoning",
    "calendar": "gemini_reasoning",
    "email": "gemini_reasoning",
    "website_builder": "gemini_reasoning",
    "image_generation": "gemini_reasoning",
    "analytics": "gemini_reasoning",
    "customer_support": "gemini_reasoning",
    "orders": "gemini_reasoning",
    "memory": "gemini_reasoning",
    "human_handoff": "gemini_reasoning"
  },

  "secrets": {
    "openai_key_env": "XPAND_OPENAI_API_KEY",
    "model_env": "XPAND_OPENAI_MODEL",
    "store_secrets_in_git": false
  },

  "isolation": {
    "share_kemo_provider": false,
    "share_kemo_memory": false,
    "share_other_agent_keys": false,
    "share_other_agent_provider_state": false
  },

  "verification": {
    "text_openai_verified": false,
    "voice_openai_reasoning_verified": false,
    "verified_model": null
  }
}
