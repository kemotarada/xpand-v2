{
  "schema_version": "2.0",
  "agent_id": "xpand",
  "name": "XPAND",
  "slug": "xpand",
  "description": "XPAND is an intelligent AI agent working for XPAND company and assisting Ihab across Telegram text, voice, live calls, memory, tools, scheduling, web access and agent capabilities.",
  "status": "active",

  "identity": {
    "agent_name": "XPAND",
    "runtime_identity": "xpand",
    "environment": "production",
    "independent_agent": true,
    "runtime_dependency_on_kemo": false
  },

  "ownership": {
    "managed_by": "xpand",
    "created_from": "XPAND V2",
    "factory_origin": "XPAND",
    "owner_only_management": true,
    "runtime_dependency_on_factory": false
  },

  "telegram": {
    "enabled": true,
    "display_name": "XPAND",
    "username": "@XPANDIHAB220_bot",
    "managed_bot": true,
    "bot_management_mode": true,
    "text_enabled": true,
    "voice_enabled": true,
    "live_call_enabled": true,
    "token_storage": "secure_runtime_only",
    "token_in_repository": false
  },

  "ai": {
    "type": "general_ai",
    "purpose": "Act as XPAND company's persistent intelligent AI agent and assist Ihab across text, voice and live calls.",
    "language_mode": "ar",
    "respond_in_user_language": true,
    "default_language": "ar",
    "default_dialect": "palestinian_shami",
    "timezone": "Asia/Hebron",
    "independent_from_kemo_personal_memory": true,
    "runtime_dependency_on_kemo": false
  },

  "capabilities": {
    "general_chat": {
      "enabled": true,
      "status": "active"
    },

    "voice": {
      "enabled": true,
      "status": "active",
      "input": "telegram_voice",
      "speech_to_text": true,
      "text_to_speech": true,
      "reply_mode": "voice_to_voice",
      "same_identity_as_text": true,
      "same_memory_as_text": true
    },

    "live_call": {
      "enabled": true,
      "status": "active",
      "same_identity_as_text": true,
      "same_memory_as_text": true,
      "same_personality_as_text": true,
      "barge_in": true,
      "real_time_conversation": true
    },

    "memory": {
      "enabled": true,
      "persistent": true,
      "cross_channel": true
    },

    "web_search": {
      "enabled": true
    },

    "scheduler": {
      "enabled": true
    },

    "agent_factory": {
      "enabled": true
    },

    "desktop": {
      "enabled": true
    }
  },

  "memory": {
    "enabled": true,
    "persistent": true,
    "scope": "xpand_only",
    "subject": "primary_user",
    "share_with_kemo_personal_memory": false,

    "channels": {
      "telegram_text": true,
      "telegram_voice": true,
      "live_call": true
    },

    "continuity": {
      "unified_identity": true,
      "unified_memory": true,
      "unified_preferences": true,
      "unified_user_profile": true,
      "unified_conversation_context": true
    }
  },

  "security": {
    "store_secrets_in_git": false,
    "expose_tokens_in_logs": false,
    "allow_arbitrary_shell": false,
    "allow_automatic_external_actions": false,
    "runtime_isolated_from_kemo": true,
    "database_isolated": true,
    "secrets_isolated": true
  },

  "deployment": {
    "mode": "dedicated_runtime",
    "github_repo": "kemotarada/xpand-v2",
    "railway_project": "xpand-v2-production",

    "services": {
      "telegram_bot": "kemo-telegram-bot",
      "call": "kemo-call",
      "desktop": "kemo-desktop",
      "scheduler": "kemo-scheduler",
      "database": "Postgres"
    },

    "dedicated_repository": true,
    "dedicated_railway_project": true,
    "dedicated_database": true,
    "dedicated_secrets": true,
    "runtime_dependency_on_kemo": false
  },

  "template": {
    "source": "kemotarada/xpand-v2",
    "source_type": "standalone_repository",
    "copied_from_kemo": false,
    "template_runtime_dependency": false
  },

  "files": {
    "system_prompt": "agents/xpand/system_prompt.md",
    "capabilities": "agents/xpand/capabilities.json",
    "config": "agents/xpand/agent.json"
  },

  "created_by": "XPAND",

  "notes": "XPAND is an independent production AI agent for XPAND company. Its primary user is Ihab. XPAND operates independently with its own runtime, database, memory and secrets. Never store Telegram bot tokens, API keys, database credentials or other secrets in this file."
}
