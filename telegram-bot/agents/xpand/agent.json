{
  "schema_version": "1.0",
  "agent_id": "xpand",
  "name": "XPAND Agent",
  "slug": "xpand",
  "description": "General AI assistant for XPAND with Telegram text and voice interaction.",
  "status": "active",

  "ownership": {
    "managed_by": "kemo",
    "factory": "KEMO Agent Factory",
    "owner_only_management": true
  },

  "telegram": {
    "enabled": true,
    "display_name": "XPAND Agent",
    "username": "@XPAND_ihabBot",
    "managed_bot": true,
    "bot_management_mode": true,
    "token_storage": "secure_runtime_only",
    "token_in_repository": false
  },

  "ai": {
    "type": "general_ai",
    "purpose": "Answer general questions and assist users naturally.",
    "language_mode": "auto",
    "respond_in_user_language": true,
    "independent_from_kemo_personal_memory": true
  },

  "capabilities": {
    "general_chat": {
      "enabled": true,
      "status": "verified"
    },

    "voice": {
      "enabled": true,
      "status": "verified",
      "input": "telegram_voice",
      "speech_to_text": true,
      "text_to_speech": true,
      "reply_mode": "voice_to_voice"
    }
  },

  "memory": {
    "enabled": true,
    "type": "conversation_history",
    "scope": "xpand_only",
    "share_with_kemo_personal_memory": false
  },

  "security": {
    "store_secrets_in_git": false,
    "expose_tokens_in_logs": false,
    "allow_arbitrary_shell": false,
    "allow_automatic_external_actions": false
  },

  "deployment": {
    "mode": "shared_kemo_runtime",
    "github_repo": "kemo-telegram-bot",
    "railway_service": "kemo-telegram-bot",
    "dedicated_repository": false,
    "dedicated_railway_service": false
  },

  "future_architecture": {
    "dedicated_github_repository": true,
    "dedicated_railway_project": true,
    "dedicated_railway_service": true
  },

  "files": {
    "system_prompt": "agents/xpand/system_prompt.md",
    "capabilities": "agents/xpand/capabilities.json",
    "config": "agents/xpand/config.json"
  },

  "created_by": "KEMO Agent Factory",
  "notes": "This file contains configuration only. Never store Telegram bot tokens, API keys, database credentials, or other secrets here."
}
