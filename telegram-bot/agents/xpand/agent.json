{
  "schema_version": "2.0",
  "agent_id": "xpand",
  "name": "XPAND",
  "slug": "xpand",
  "description": "Independent personal AI agent with unified Telegram text, voice, live call, memory, tools, scheduling, web access and agent capabilities.",
  "status": "active",

  "identity": {
    "agent_name": "XPAND",
    "runtime_identity": "xpand",
    "environment": "production",
    "independent_agent": true,
    "runtime_dependency_on_kemo": false
  },

  "ownership": {
    "managed_by": "xpand",
    "created_from": "KEMO Master Template",
    "factory_origin": "KEMO Agent Factory",
    "owner_only_management": true,
    "runtime_dependency_on_factory": false
  },

  "telegram": {
    "enabled": true,
    "display_name": "XPAND",
    "username": "@XPANDIHAB220_bot",
    "managed_bot": true,
    "bot_management_mode": true,
    "text_enabled": true,
    "voice_enabled": true,
    "live_call_enabled": true,
    "token_storage": "secure_runtime_only",
    "token_in_repository": false
  },

  "ai": {
    "type": "general_ai",
    "purpose": "Act as the user's persistent intelligent personal AI agent across text, voice and live calls.",
    "language_mode": "auto",
    "respond_in_user_language": true,
    "default_language": "ar",
    "default_dialect": "palestinian",
    "timezone": "Asia/Hebron",
    "independent_from_kemo_personal_memory": true,
    "runtime_dependency_on_kemo": false
  },

  "capabilities": {
    "general_chat": {
      "enabled": true,
      "status": "active"
    },

    "voice": {
      "enabled": true,
      "status": "active",
      "input": "telegram_voice",
      "speech_to_text": true,
      "text_to_speech": true,
      "reply_mode": "voice_to_voice",
      "same_identity_as_text": true,
      "same_memory_as_text": true
    },

    "live_call": {
      "enabled": true,
      "status": "active",
      "same_identity_as_text": true,
      "same_memory_as_text": true,
      "same_personality_as_text": true,
      "barge_in": true,
      "real_time_conversation": true
    },

    "memory": {
      "enabled": true,
      "persistent": true,
      "cross_channel": true
    },

    "web_search": {
      "enabled": true
    },

    "scheduler": {
      "enabled": true
    },

    "agent_factory": {
      "enabled": true
    },

    "desktop": {
      "enabled": true
    }
  },

  "memory": {
    "enabled": true,
    "persistent": true,
    "scope": "xpand_only",
    "subject": "primary_user",
    "share_with_kemo_personal_memory": false,

    "channels": {
      "telegram_text": true,
      "telegram_voice": true,
      "live_call": true
    },

    "continuity": {
      "unified_identity": true,
      "unified_memory": true,
      "unified_preferences": true,
      "unified_user_profile": true,
      "unified_conversation_context": true
    }
  },

  "security": {
    "store_secrets_in_git": false,
    "expose_tokens_in_logs": false,
    "allow_arbitrary_shell": false,
    "allow_automatic_external_actions": false,
    "runtime_isolated_from_kemo": true,
    "database_isolated": true,
    "secrets_isolated": true
  },

  "deployment": {
    "mode": "dedicated_runtime",
    "github_repo": "kemotarada/xpand-v2",
    "railway_project": "xpand-v2-production",

    "services": {
      "telegram_bot": "kemo-telegram-bot",
      "call": "kemo-call",
      "desktop": "kemo-desktop",
      "scheduler": "kemo-scheduler",
      "database": "Postgres"
    },

    "dedicated_repository": true,
    "dedicated_railway_project": true,
    "dedicated_database": true,
    "dedicated_secrets": true,
    "runtime_dependency_on_kemo": false
  },

  "template": {
    "source": "kemotarada/kemo-master-template",
    "source_type": "github_template",
    "copied_from_kemo": true,
    "template_runtime_dependency": false
  },

  "files": {
    "system_prompt": "agents/xpand/system_prompt.md",
    "capabilities": "agents/xpand/capabilities.json",
    "config": "agents/xpand/config.json"
  },

  "created_by": "KEMO Master Template",

  "notes": "XPAND is an independent runtime created from the KEMO master template. KEMO is the template/factory origin only and is not required for XPAND to operate. Never store Telegram bot tokens, API keys, database credentials or other secrets in this file."
}
